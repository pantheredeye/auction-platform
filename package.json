{
  "name": "auction-platform",
  "version": "1.0.0",
  "description": "M&M Auctions platform",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && npm run clean && npm run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "seed": "rw-scripts worker-run ./src/scripts/seed.ts",
    "migrate:local": "wrangler d1 migrations apply auction-platform-db --local",
    "migrate:remote": "wrangler d1 migrations apply auction-platform-db --remote",
    "release:staging": "rw-scripts ensure-deploy-env && npm run clean && npm run build && node scripts/staging-config.js && wrangler deploy --config dist/worker/wrangler.staging.json",
    "migrate:staging": "wrangler d1 migrations apply auction-platform-db-staging --remote --env staging"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "kysely": "^0.27.5",
    "kysely-d1": "^0.3.0",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-server-dom-webpack": "19.2.3",
    "rwsdk": "1.0.0-beta.47",
    "sonner": "^1.7.0",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.17.1",
    "@cloudflare/workers-types": "4.20260103.0",
    "@types/node": "~24.5.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "wrangler": "4.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
